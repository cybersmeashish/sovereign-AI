{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cybersmeashish/sovereign-AI/schemas/sovereignty-profile.schema.json",
  "title": "Sovereignty Profile",
  "type": "object",
  "required": [
    "use_case_id",
    "owner",
    "risk_class",
    "permitted_domains",
    "permitted_jurisdictions"
  ],
  "properties": {
    "use_case_id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "risk_class": {
      "enum": [
        "minimal",
        "limited",
        "high",
        "prohibited"
      ]
    },
    "permitted_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "aws-commercial",
          "aws-eusc",
          "vmware-private",
          "hpe-sovereign",
          "hpe-disconnected"
        ]
      }
    },
    "permitted_jurisdictions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ISO 3166-1 alpha-2"
      }
    },
    "max_data_class": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "key_custody": {
      "enum": [
        "customer",
        "provider",
        "hsm-local"
      ]
    },
    "administrator_eligibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_egress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomy_hours": {
      "type": "integer",
      "minimum": 0
    },
    "approved_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country_only": {
      "type": "boolean"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
